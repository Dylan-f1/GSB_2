<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!--
      Modifier les valeurs ci-dessous selon votre configuration MySQL locale.
      uid   : nom d'utilisateur MySQL (par défaut : root)
      pwd   : mot de passe MySQL (laisser vide si aucun mot de passe)
      database : nom de la base de données (ne pas modifier)
    -->
    <add name="GSB2"
         connectionString="server=localhost;port=3306;uid=root;pwd=rootpassword;database=GSB2;charset=utf8mb4"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
